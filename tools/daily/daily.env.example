# Copy to  %USERPROFILE%\.narxnoma-daily.env  (OUTSIDE this repo) and fill in. Never commit the real file.

# --- catalogue API (the store's admin product list) ---
ECOM_PRODUCTS_URL=https://<your-store-host>/api/admin/products
ECOM_EXTRA_PARAMS=include_inactive=true
ECOM_PAGE_SIZE=100
# The bearer token is rotated by another job; point at the file that job keeps fresh.
# Plain text, JSON ({"access_token": "..."}) or KEY=VALUE (ECOM_TOKEN=...) are all read.
ECOM_TOKEN_FILE=C:\path\to\the\file\that\holds\the\current\token
# Field names, only if `python -m narxnoma.daily probe` shows the defaults are wrong
# (dotted paths allowed, e.g. category.name):
#ECOM_FIELD_NAME=name
#ECOM_FIELD_PRICE=price
#ECOM_FIELD_CATEGORY=category.name
#ECOM_FIELD_ACTIVE=is_active
ECOM_ONLY_ACTIVE=1

# --- Telegram: an existing, already logged-in user session (sends to Saved Messages) ---
TG_API_ID=
TG_API_HASH=
TG_SESSION=C:\path\to\userbot_session        # the .session file, with or without the extension

# --- where the daily files, cache and logs live ---
NARXNOMA_DAILY_DIR=C:\narxnoma-daily
